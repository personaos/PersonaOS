# PersonaOS Environment Configuration

# ==============================================
# CORE SYSTEM SETTINGS
# ==============================================

# Local LLM Configuration (Recommended for privacy)
LLM_PROVIDER=ollama
OLLAMA_MODEL=openhermes
OLLAMA_API_URL=  # leave empty if using CLI mode

# Configuration Directory (for encrypted API keys)
PERSONAOS_CONFIG_DIR=config

# ==============================================
# API KEYS (Optional - Stored Encrypted)
# ==============================================
# Note: Use the API manager for secure storage instead of plain text
# These are kept for backward compatibility only

# OpenAI (GPT models)
OPENAI_API_KEY=

# Anthropic (Claude models)  
ANTHROPIC_API_KEY=

# Google AI (Gemini models)
GOOGLE_API_KEY=

# Cohere (Command models)
COHERE_API_KEY=

# Wakeword Detection
PICOVOICE_API_KEY=

# Text-to-Speech
ELEVENLABS_API_KEY=

# ==============================================
# AUDIO & VOICE SETTINGS
# ==============================================

# Speech-to-Text (STT) Configuration
STT_ENABLED=false
STT_MODEL=base  # tiny, base, small, medium, large
STT_LANGUAGE=en  # auto-detect if empty
STT_DEVICE_INDEX=  # leave empty for default microphone

# Text-to-Speech (TTS) Configuration
TTS_ENABLED=true  # Enable text-to-speech output
TTS_VOICE=  # leave empty for system default voice
TTS_LANGUAGE=en  # Language for TTS output
TTS_RATE=200  # Speech rate (words per minute)
TTS_VOLUME=0.9  # Speech volume (0.0 to 1.0)
TTS_STREAMING_ENABLED=true  # Enable streaming TTS for real-time response

# Voice Pipeline Controller Settings
VOICE_PIPELINE_ENABLED=true  # Enable complete voice conversation pipeline
VOICE_AUTO_START=false  # Automatically start voice session on startup
VOICE_RESPONSE_TIMEOUT=30  # Seconds to wait for voice processing
VOICE_STATE_CALLBACKS=true  # Enable voice state change notifications
VOICE_METRICS_ENABLED=true  # Track voice conversation performance

# Voice Error Handling & Fallback Settings
VOICE_FALLBACK_ENABLED=true  # Enable automatic fallback to text mode
VOICE_MAX_RETRIES=3  # Maximum retry attempts before disabling voice pipeline
TTS_FALLBACK_ENABLED=true  # Enable fallback to text display when TTS fails

# Audio device configuration
MIC_DEVICE_INDEX=
SPEAKER_DEVICE_INDEX=

# ==============================================
# MEMORY & CONVERSATION SETTINGS
# ==============================================
MEMORY_ENABLED=true
MEMORY_DIR=data/memory
ENABLE_PERSISTENT_MEMORY=true
MAX_SESSION_MESSAGES=50
MAX_CONTEXT_LENGTH=4000
MEMORY_RETENTION_DAYS=30

# ==============================================
# INTENT & SAFETY SETTINGS
# ==============================================
INTENT_ENABLED=true
SAFETY_LEVEL=standard  # strict, standard, relaxed
ALLOW_TOOL_EXECUTION=true
MAX_INTENT_CONFIDENCE=1.0

# ==============================================
# ADVANCED SETTINGS
# ==============================================

# API Rate Limiting
DEFAULT_RATE_LIMIT=60  # requests per minute
MONTHLY_QUOTA_WARNING=true

# Encryption & Security
USE_ENCRYPTED_STORAGE=true
AUTO_MIGRATE_ENV_KEYS=true

# Development & Debugging
DEBUG_MODE=false
LOG_LEVEL=INFO
ENABLE_API_LOGGING=false

# Web UI Settings
WEB_UI_ENABLED=true
WEB_UI_PORT=8000
FRONTEND_PORT=3000

# ==============================================
# MIGRATION NOTICE
# ==============================================
# For enhanced security, use the API Manager:
#   python -c "from core.api_manager import add_api_key; add_api_key('openai', 'your-key-here')"
# This stores keys encrypted instead of plain text.
